# ---- Copy this file to .env.local and fill in what you have. The site runs without any of it (uses built-in sample data). ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase (free) — Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — never share
# Email (Resend, free)
RESEND_API_KEY=
OWNER_NOTIFY_EMAIL=visafeast@gmail.com
# Cloudflare Turnstile (free bot protection). Empty = forms still work but without the check (dev only)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Cron + analytics salts (any long random text)
CRON_SECRET=
DAILY_SALT_SECRET=change-me
# Optional AI (chatbot, decoder AI mode, weekly digest). none | gemini | anthropic
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
LLM_DAILY_CAP=60
# Analytics / SEO
NEXT_PUBLIC_GA_ID=
PEXELS_API_KEY=                       # free, for the admin photo search
GOOGLE_SEARCH_CONSOLE_CREDENTIALS=    # base64 service-account JSON
INDEXNOW_KEY=
CALCOM_WEBHOOK_SECRET=
